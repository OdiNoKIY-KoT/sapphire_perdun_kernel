// SPDX-License-Identifier: GPL-2.0-only
/*
 * Stock dtbo.img entry 28: Qualcomm Technologies, Inc. Khaje IDP
 * Kernel board overlay part, reconstructed from the stock image
 * (Qualcomm reference board as built in the Xiaomi sapphire tree).
 */

/dts-v1/;
/plugin/;

/ {
	model = "Qualcomm Technologies, Inc. Khaje IDP";
	compatible = "qcom,khaje-idp", "qcom,khaje", "qcom,idp";
	qcom,msm-id = <0x231 0x10000>;
	qcom,board-id = <0x10022 0x0>;
	qcom,pmic-id = <0x2d 0x2e 0x0 0x0>;
};

#include <dt-bindings/clock/qcom,gcc-khaje.h>
#include <dt-bindings/clock/qcom,rpmcc.h>
#include <dt-bindings/iio/qti_power_supply_iio.h>

&thermal_zones {
	pm6125-tz {
		cooling-maps {
			trip0_cpu0 {
				trip = <&pm6125_trip0>;
				cooling-device = <&CPU0 7 7>;
			};

			trip0_cpu4 {
				trip = <&pm6125_trip0>;
				cooling-device = <&CPU4 6 0xffffffff>;
			};

			trip1_cpu1 {
				trip = <&pm6125_trip1>;
				cooling-device = <&cpu1_pause 1 1>;
			};

			trip1_cpu2 {
				trip = <&pm6125_trip1>;
				cooling-device = <&cpu2_pause 1 1>;
			};

			trip1_cpu3 {
				trip = <&pm6125_trip1>;
				cooling-device = <&cpu3_pause 1 1>;
			};

			trip1_cpu4 {
				trip = <&pm6125_trip1>;
				cooling-device = <&cpu4_pause 1 1>;
			};

			trip1_cpu5 {
				trip = <&pm6125_trip1>;
				cooling-device = <&cpu5_pause 1 1>;
			};

			trip1_cpu6 {
				trip = <&pm6125_trip1>;
				cooling-device = <&cpu6_pause 1 1>;
			};

			trip1_cpu7 {
				trip = <&pm6125_trip1>;
				cooling-device = <&cpu7_pause 1 1>;
			};
		};
	};
};

&soc {
	fingerprint_xiaomi {
		compatible = "xiaomi,xiaomi-fp";
		xiaomi,gpio_irq = <&tlmm 83 0>;
		vfp-supply = <&pm6125_l9>;
		netlink-event = <29>;
		fp-gpio-pwr = <&tlmm 65 0>;
		pinctrl-names = "reset_high", "reset_low", "eint_default", "eint_pulldown", "pwr_high", "pwr_low";
		pinctrl-0 = <&fingerprints_reset_high>;
		pinctrl-1 = <&fingerprints_reset_low>;
		pinctrl-2 = <&fingerprints_eint_default>;
		pinctrl-3 = <&fingerprints_eint_pulldown>;
		pinctrl-4 = <&fingerprints_pwr_high>;
		pinctrl-5 = <&fingerprints_pwr_low>;
		status = "okay";
	};
};

&tlmm {
	fingerprints_reset_high: fingerprints_reset_high {
		mux {
			pins = "gpio104";
			function = "gpio";
		};

		config {
			pins = "gpio104";
			drive-strength = <2>;
			bias-disable;
			output-high;
		};
	};

	fingerprints_reset_low: fingerprints_reset_low {
		mux {
			pins = "gpio104";
			function = "gpio";
		};

		config {
			pins = "gpio104";
			drive-strength = <2>;
			bias-disable;
			output-low;
		};
	};

	fingerprints_eint_default: fingerprints_eint_default {
		mux {
			pins = "gpio83";
			function = "gpio";
		};

		config {
			pins = "gpio83";
			drive-strength = <2>;
			bias-disable;
		};
	};

	fingerprints_eint_pulldown: fingerprints_eint_pulldown {
		mux {
			pins = "gpio83";
			function = "gpio";
		};

		config {
			pins = "gpio83";
			drive-strength = <2>;
			bias-pull-down;
		};
	};

	fingerprints_pwr_high: fingerprints_pwr_high {
		mux {
			pins = "gpio65";
			function = "gpio";
		};

		config {
			pins = "gpio65";
			drive-strength = <2>;
			bias-disable;
			output-high;
		};
	};

	fingerprints_pwr_low: fingerprints_pwr_low {
		mux {
			pins = "gpio65";
			function = "gpio";
		};

		config {
			pins = "gpio65";
			drive-strength = <2>;
			bias-disable;
			output-high;
		};
	};
};

&pm6125_vadc {
	pinctrl-0 = <&camera_therm_default &emmc_therm_default &rf_pa1_therm_default>;

	rf_pa1_therm {
		reg = <0x55>;
		label = "rf_pa1_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
	};
};

&pm6125_adc_tm {
	status = "ok";

	rf_pa1_therm {
		reg = <0x3>;
		io-channels = <&pm6125_vadc 85>;
		qcom,ratiometric;
		qcom,hw-settle-time-us = <200>;
	};
};

&thermal_zones {
	rf-pa1-therm-usr {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "user_space";
		thermal-sensors = <&pm6125_adc_tm 3>;
		wake-capable-sensor;

		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};
};

&pm6125_gpios {
	oled_vci {
		oled_vci_default: oled_vci_default {
			pins = "gpio9";
			function = "normal";
			input-disable;
			power-source = <0>;
			bias-disable;
			output-high;
			qcom,drive-strength = <2>;
		};

		oled_vci_suspend: oled_vci_suspend {
			pins = "gpio9";
			function = "normal";
			input-disable;
			power-source = <0>;
			bias-disable;
			output-low;
			qcom,drive-strength = <2>;
		};
	};

	cam_avdd1 {
		cam_sensor_avdd1_default: cam_sensor_avdd1_default {
			pins = "gpio2";
			function = "normal";
			bias-disable;
			power-source = <0>;
			qcom,drive-strength = <2>;
		};

		cam_sensor_avdd1_suspend: cam_sensor_avdd1_suspend {
			pins = "gpio2";
			function = "normal";
			output-low;
			bias-disable;
			power-source = <0>;
			qcom,drive-strength = <2>;
		};
	};

	flash {
		flash_default: flash_default {
			pins = "gpio8";
			function = "normal";
			output-high;
			bias-pull-up;
			power-source = <1>;
			qcom,drive-strength = <2>;
		};

		flash_suspend: flash_suspend {
			pins = "gpio8";
			function = "normal";
			output-low;
			bias-disable;
			power-source = <1>;
			qcom,drive-strength = <2>;
		};
	};

	rf_pa1_therm {
		rf_pa1_therm_default: rf_pa1_therm_default {
			pins = "gpio7";
			bias-high-impedance;
		};
	};

	key_vol_up {
		key_vol_up_default: key_vol_up_default {
			pins = "gpio5";
			function = "normal";
			input-enable;
			bias-pull-up;
			power-source = <0>;
		};
	};

	eldo9_pin {
		usb_eldo9: gpio@c000 {
			pins = "gpio1";
			function = "normal";
			qcom,drive-strength = <2>;
			power-source = <0>;
			bias-disable;
			output-high;
		};
	};
};

&soc {
	gpio_keys {
		compatible = "gpio-keys";
		label = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&key_vol_up_default>;

		vol_up {
			label = "volume_up";
			gpios = <&pm6125_gpios 5 1>;
			linux,input-type = <1>;
			linux,code = <115>;
			linux,can-disable;
			debounce-interval = <15>;
			gpio-key,wakeup;
		};
	};

	ant_check {
		compatible = "ant_check";
		interrupt-parent = <&tlmm>;
		ant_check_gpio = <&tlmm 107 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&ant_check_default>;
	};

	ant_check_div {
		compatible = "ant_check_div";
		interrupt-parent = <&tlmm>;
		ant_check_div_gpio = <&tlmm 25 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&ant_check_div_default>;
	};

	vdda_usb_ss_dp_core: vdda_usb_ss_dp_core {
		compatible = "regulator-fixed";
		regulator-name = "vdd_supply";
		regulator-min-microvolt = <880000>;
		regulator-max-microvolt = <880000>;
		enable-active-high;
		gpio = <&pm6125_gpios 1 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb_eldo9>;
	};
};

&usb_qmp_dp_phy {
	vdd-supply = <&vdda_usb_ss_dp_core>;
};

&sdhc_1 {
	vdd-supply = <&L24A>;
	qcom,vdd-voltage-level = <2960000 2960000>;
	qcom,vdd-current-level = <0 570000>;
	vdd-io-supply = <&L11A>;
	qcom,vdd-io-always-on;
	qcom,vdd-io-lpm-sup;
	qcom,vdd-io-voltage-level = <1800000 1800000>;
	qcom,vdd-io-current-level = <0 325000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&sdc1_on>;
	pinctrl-1 = <&sdc1_off>;
	status = "ok";
};

&sdhc_2 {
	vdd-supply = <&L22A>;
	qcom,vdd-voltage-level = <2960000 2960000>;
	qcom,vdd-current-level = <0 800000>;
	vdd-io-supply = <&L5A>;
	qcom,vdd-io-voltage-level = <1800000 2960000>;
	qcom,vdd-io-current-level = <0 22000>;
	vdd-io-bias-supply = <&L7A>;
	qcom,vdd-io-bias-voltage-level = <1256000 1256000>;
	qcom,vdd-io-bias-current-level = <0 6000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&sdc2_on>;
	pinctrl-1 = <&sdc2_off>;
	cd-gpios = <&tlmm 88 1>;
	status = "ok";
};

&ufsphy_mem {
	compatible = "qcom,ufs-phy-qmp-v4-khaje";
	vdda-phy-supply = <&L4A>;
	vdda-pll-supply = <&L18A>;
	vdda-phy-max-microamp = <85700>;
	vdda-pll-max-microamp = <18300>;
	status = "ok";
};

&ufshc_mem {
	vdd-hba-supply = <&gcc_ufs_phy_gdsc>;
	vdd-hba-fixed-regulator;
	vcc-supply = <&L24A>;
	vcc-max-microamp = <800000>;
	vccq2-supply = <&L11A>;
	vccq2-max-microamp = <800000>;
	qcom,vddp-ref-clk-supply = <&L18A>;
	qcom,vddp-ref-clk-max-microamp = <100>;
	reset-gpios = <&tlmm 113 1>;
	resets = <&gcc GCC_UFS_PHY_BCR>;
	reset-names = "rst";
	status = "ok";
};

&pm6125_pwm {
	status = "ok";
};

&qupv3_se2_i2c {
	status = "okay";
	qcom,i2c-touch-active = "synaptics,tcm-i2c";

	synaptics_tcm@20 {
		compatible = "synaptics,tcm-i2c";
		reg = <0x20>;
		interrupt-parent = <&tlmm>;
		interrupts = <80 8200>;
		pinctrl-names = "pmx_ts_active", "pmx_ts_suspend", "pmx_ts_release";
		pinctrl-0 = <&ts_int_active &ts_reset_active>;
		pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
		pinctrl-2 = <&ts_release>;
		synaptics,irq-gpio = <&tlmm 80 8200>;
		synaptics,irq-on-state = <0>;
		synaptics,reset-gpio = <&tlmm 86 0>;
		synaptics,reset-on-state = <0>;
		synaptics,reset-active-ms = <20>;
		synaptics,reset-delay-ms = <200>;
		synaptics,power-delay-ms = <200>;
		synaptics,ubl-i2c-addr = <0x20>;
		synaptics,extend_report;
		synaptics,firmware-name = "synaptics_firmware_k.img";
	};

	novatek@62 {
		reg = <0x62>;
		status = "ok";
		interrupt-parent = <&tlmm>;
		interrupts = <80 8200>;
		pinctrl-names = "pmx_ts_active", "pmx_ts_suspend", "pmx_ts_release";
		pinctrl-0 = <&ts_int_active &ts_reset_active>;
		pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
		pinctrl-2 = <&ts_release>;
		novatek,reset-gpio = <&tlmm 86 0>;
		novatek,irq-gpio = <&tlmm 80 8200>;
	};
};

&spmi_bus {
	#address-cells = <2>;
	#size-cells = <0>;
	interrupt-controller;
	#interrupt-cells = <4>;

	qcom,pm7250b@2 {
		compatible = "qcom,spmi-pmic";
		reg = <0x2 0x0>;
		#address-cells = <1>;
		#size-cells = <0>;

		pm7250b_charger: qcom,qpnp-smb5 {
			compatible = "qcom,pm7250b-smb5";
			depends-on-supply = <&pm7250b_vadc>;
			#address-cells = <1>;
			#size-cells = <1>;
			#cooling-cells = <2>;
			qcom,thermal-mitigation = <5950000 5400000 5000000 4500000 4000000 3700000 3500000 3000000
			                           2800000 2500000 2000000 1500000 1000000 800000 500000 350000
			                           800000 800000>;
			qcom,hvdcp2-max-icl-ua = <2000000>;
			qcom,hvdcp2-12v-max-icl-ua = <1500000>;
			status = "ok";
			#io-channel-cells = <1>;
			io-channels = <&pm7250b_vadc 8 &pm7250b_vadc 7
			               &pm7250b_vadc 9 &pm7250b_vadc 6
			               &pm7250b_vadc 79 &pm7250b_vadc 153
			               &pm7250b_vadc 131 &pm7250b_vadc 77
			               &pm7250b_qg PSY_IIO_RESISTANCE_ID &pm7250b_qg PSY_IIO_FASTCHARGE_MODE
			               &pm7250b_qg PSY_IIO_VOLTAGE_NOW &pm7250b_qg PSY_IIO_TEMP
			               &pm7250b_qg PSY_IIO_CAPACITY &pm7250b_qg PSY_IIO_VOLTAGE_OCV
			               &pm7250b_qg PSY_IIO_VOLTAGE_AVG &pm7250b_qg PSY_IIO_DEBUG_BATTERY
			               &pm7250b_qg PSY_IIO_REAL_CAPACITY &pm7250b_qg PSY_IIO_CC_SOC
			               &pm7250b_qg PSY_IIO_CURRENT_NOW &pm7250b_qg PSY_IIO_VOLTAGE_MAX
			               &pm7250b_qg PSY_IIO_CHARGE_FULL &pm7250b_qg PSY_IIO_CHARGE_COUNTER
			               &pm7250b_qg PSY_IIO_CYCLE_COUNT &pm7250b_qg PSY_IIO_CHARGE_FULL_DESIGN
			               &pm7250b_qg PSY_IIO_TIME_TO_FULL_NOW &pm7250b_qg PSY_IIO_FFC_CHG_TERMINATION_CURRENT
			               &sc8541_standalone PSY_IIO_SC_BUS_CURRENT &sc8541_standalone PSY_IIO_SC_CHIP_VENDOR
			               &auth_battery PSY_IIO_AUTH_BATT_ID &auth_battery PSY_IIO_AUTH_AUTHEN_RESULT
			               &auth_battery PSY_IIO_AUTH_MANUFACTURER &auth_battery PSY_IIO_AUTH_CHIP_OK
			               &bq25960_standalone PSY_IIO_SC_BUS_CURRENT &bq25960_standalone PSY_IIO_SC_CHIP_VENDOR
			               &pm7250b_qg PSY_IIO_SOC_DECIMAL &pm7250b_qg PSY_IIO_SOC_DECIMAL_RATE
			               &pm7250b_qg PSY_IIO_SHUTDOWN_DELAY &pm7250b_qg PSY_IIO_BATT_FULL_CURRENT
			               &bq25960_standalone PSY_IIO_SET_ACDRV &pm7250b_charger PSY_IIO_RECHARGE_MODE>;
			io-channel-names = "usb_in_voltage", "usb_in_current", "chg_temp", "die_temp", "conn_temp", "sbux_res", "vph_voltage", "skin_temp", "resistance_id", "fastcharge_mode", "voltage_now", "temp", "capacity", "voltage_ocv", "voltage_avg", "debug_battery", "real_capacity", "cc_soc", "current_now", "voltage_max", "charge_full", "charge_counter", "cycle_count", "charge_full_design", "time_to_full_now", "ffc_chg_termination_current", "sc_bus_current", "sc_manufacturer", "auth_batt_id", "auth_authen_result", "auth_manufacturer", "auth_chip_ok", "bq_bus_current", "bq_manufacturer", "soc_decimal", "soc_decimal_rate", "shutdown_delay", "batt_full_current", "bq_set_acdrv", "recharg_mode";
			qcom,battery-data = <&mtp_batterydata>;
			qcom,sec-charger-config = <0>;
			qcom,auto-recharge-soc = <95>;
			qcom,auto-recharge-vbat-mv = <100>;
			qcom,step-charging-enable;
			qcom,sw-jeita-enable;
			mi,use_third_cp;
			mi,support-ffc;
			qcom,distinguish-qc-class-ab;
			qcom,charger-temp-max = <800>;
			qcom,smb-temp-max = <800>;
			qcom,suspend-input-on-debug-batt;
			qcom,fcc-stepping-enable;
			qcom,fcc-step-delay-ms = <100>;
			qcom,fcc-step-size-ua = <100000>;
			qcom,smb-internal-pull-kohm = <0>;
			qcom,en-skin-therm-mitigation;
			qcom,hvdcp3-standalone-config;
			qcom,chg-term-current-ma = <0xffffff06>;
			qcom,fcc-max-ua = <6000000>;
			qcom,fv-max-uv = <4500000>;
			qcom,disable-suspend-on-collapse;
			dpdm-supply = <&usb2_phy0>;

			qcom,chgr@1000 {
				reg = <0x1000>;
				interrupts = <2 16 0 1 2 16 1 1
				              2 16 2 1 2 16 3 1
				              2 16 4 1 2 16 5 1
				              2 16 6 1 2 16 7 1>;
				interrupt-names = "chgr-error", "chg-state-change", "step-chg-state-change", "step-chg-soc-update-fail", "step-chg-soc-update-req", "fg-fvcal-qualified", "vph-alarm", "vph-drop-prechg";
			};

			qcom,dcdc@1100 {
				reg = <0x1100>;
				interrupts = <2 17 0 1 2 17 1 1
				              2 17 2 1 2 17 3 3
				              2 17 4 3 2 17 5 3
				              2 17 6 1 2 17 7 3>;
				interrupt-names = "otg-fail", "otg-oc-disable-sw", "otg-oc-hiccup", "bsm-active", "high-duty-cycle", "input-current-limiting", "concurrent-mode-disable", "switcher-power-ok";
			};

			qcom,batif@1200 {
				reg = <0x1200>;
				interrupts = <2 18 0 1 2 18 2 3
				              2 18 3 3 2 18 4 3
				              2 18 5 3 2 18 6 3
				              2 18 7 3>;
				interrupt-names = "bat-temp", "bat-ov", "bat-low", "bat-therm-or-id-missing", "bat-terminal-missing", "buck-oc", "vph-ov";
			};

			qcom,usb@1300 {
				reg = <0x1300>;
				interrupts = <2 19 0 3 2 19 1 3
				              2 19 2 3 2 19 3 3
				              2 19 4 3 2 19 5 3
				              2 19 6 1 2 19 7 1>;
				interrupt-names = "usbin-collapse", "usbin-vashdn", "usbin-uv", "usbin-ov", "usbin-plugin", "usbin-revi-change", "usbin-src-change", "usbin-icl-change";
			};

			qcom,dc@1400 {
				reg = <0x1400>;
				interrupts = <2 20 1 3 2 20 2 3
				              2 20 3 3 2 20 4 3
				              2 20 5 3 2 20 6 1
				              2 20 7 1>;
				interrupt-names = "dcin-vashdn", "dcin-uv", "dcin-ov", "dcin-plugin", "dcin-revi", "dcin-pon", "dcin-en";
			};

			qcom,typec@1500 {
				reg = <0x1500>;
				interrupts = <2 21 0 1 2 21 1 1
				              2 21 2 1 2 21 3 1
				              2 21 4 1 2 21 5 1
				              2 21 6 1 2 21 7 1>;
				interrupt-names = "typec-or-rid-detect-change", "typec-vpd-detect", "typec-cc-state-change", "typec-vconn-oc", "typec-vbus-change", "typec-attach-detach", "typec-legacy-cable-detect", "typec-try-snk-src-detect";
			};

			qcom,misc@1600 {
				reg = <0x1600>;
				interrupts = <2 22 0 1 2 22 1 1
				              2 22 2 1 2 22 3 1
				              2 22 4 3 2 22 5 1
				              2 22 6 1 2 22 7 1>;
				interrupt-names = "wdog-snarl", "wdog-bark", "aicl-fail", "aicl-done", "smb-en", "imp-trigger", "temp-change", "temp-change-smb";
			};

			qcom,chg-sdam@b000 {
				reg = <0xb000>;
			};

			smb5_vbus: qcom,smb5-vbus {
				regulator-name = "smb5-vbus";
			};

			smb5_vconn: qcom,smb5-vconn {
				regulator-name = "smb5-vconn";
			};
		};

		pm7250b_pdphy: qcom,usb-pdphy@1700 {
			compatible = "qcom,qpnp-pdphy";
			reg = <0x1700>;
			interrupts = <2 23 0 1 2 23 1 1
			              2 23 2 1 2 23 3 1
			              2 23 4 1 2 23 5 1
			              2 23 6 1 2 23 7 1>;
			interrupt-names = "sig-tx", "sig-rx", "msg-tx", "msg-rx", "msg-tx-failed", "msg-tx-discarded", "msg-rx-discarded", "fr-swap";
			#io-channel-cells = <1>;
			qcom,default-sink-caps = <5000 3000 9000 3000 12000 2250>;
			vdd-pdphy-supply = <&L15A>;
			vbus-supply = <&smb5_vbus>;
			vconn-supply = <&smb5_vconn>;
			mi,pd_curr_limit = <1>;
			mi,pd_max_curr_limit = <4000000>;
			mi,limit_pd_unverified_pps_vbus = <1>;
			mi,pd_unverified_pps_max_vbus_limit = <9500000>;
			io-channels = <&pm7250b_charger PSY_IIO_PD_ACTIVE &pm7250b_charger PSY_IIO_TYPEC_CC_ORIENTATION
			               &pm7250b_charger PSY_IIO_CONNECTOR_TYPE &pm7250b_charger PSY_IIO_TYPEC_POWER_ROLE
			               &pm7250b_charger PSY_IIO_PD_USB_SUSPEND_SUPPORTED &pm7250b_charger PSY_IIO_TYPEC_SRC_RP
			               &pm7250b_charger PSY_IIO_PD_IN_HARD_RESET &pm7250b_charger PSY_IIO_PD_CURRENT_MAX
			               &pm7250b_charger PSY_IIO_PR_SWAP &pm7250b_charger PSY_IIO_PD_VOLTAGE_MIN
			               &pm7250b_charger PSY_IIO_PD_VOLTAGE_MAX &pm7250b_charger PSY_IIO_USB_REAL_TYPE
			               &pm7250b_charger PSY_IIO_TYPEC_MODE &pm7250b_charger PSY_IIO_PE_START>;
			io-channel-names = "pd_active", "typec_cc_orientation", "connector_type", "typec_power_role", "pd_usb_suspend_supported", "typec_src_rp", "pd_in_hard_reset", "pr_current_max", "pr_swap", "pd_voltage_min", "pd_voltage_max", "real_type", "typec_mode", "pe_start";
		};

		pm7250b_tz: qcom,temp-alarm@2400 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0x2400>;
			interrupts = <2 36 0 3>;
			io-channels = <&pm7250b_vadc 6>;
			io-channel-names = "thermal";
			#thermal-sensor-cells = <0>;
			qcom,temperature-threshold-set = <1>;
		};

		pm7250b_qg: qpnp,qg {
			compatible = "qcom,pm7250b-qg";
			depends-on-supply = <&pm6125_rtc>;
			#address-cells = <1>;
			#size-cells = <1>;
			qcom,vbatt-cutoff-mv = <3400>;
			qcom,vbatt-low-mv = <3500>;
			qcom,vbatt-low-cold-mv = <3800>;
			qcom,vbatt-empty-mv = <3000>;
			qcom,vbatt-empty-cold-mv = <3000>;
			qcom,s3-entry-fifo-length = <2>;
			qcom,soc_decimal_rate = <0 32 10 30 20 28 30 28
			                         40 28 50 28 60 28 70 28
			                         80 28 90 26 95 10 99 5>;
			status = "ok";
			#io-channel-cells = <1>;
			io-channels = <&pm7250b_vadc 42 &pm7250b_vadc 75
			               &pm7250b_charger PSY_IIO_INPUT_CURRENT_LIMITED &pm7250b_charger PSY_IIO_RECHARGE_SOC
			               &pm7250b_charger PSY_IIO_FORCE_RECHARGE &pm7250b_charger PSY_IIO_CHARGE_DONE
			               &sc8541_standalone PSY_IIO_CHARGING_ENABLED &sc8541_standalone PSY_IIO_SC_BATTERY_VOLTAGE
			               &bq25960_standalone PSY_IIO_CHARGING_ENABLED &bq25960_standalone PSY_IIO_SC_BATTERY_VOLTAGE
			               &pm7250b_charger PSY_IIO_USB_REAL_TYPE>;
			io-channel-names = "batt-therm", "batt-id", "input_current_limited", "recharge_soc", "force_recharge", "charge_done", "charging_enabled", "sc_battery_voltage", "bq_charging_enabled", "bq_battery_voltage", "real_type";
			qcom,battery-data = <&mtp_batterydata>;
			qcom,qg-iterm-ma = <300>;
			qcom,hold-soc-while-full;
			qcom,linearize-soc;
			qcom,cl-feedback-on;
			qcom,tcss-enable;
			qcom,fvss-enable;
			qcom,fvss-vbatt-mv = <3600>;
			qcom,bass-enable;
			qcom,s3-entry-ibat-ua = <25000>;
			qcom,s3-exit-ibat-ua = <45000>;
			qcom,qg-ext-sns;
			qcom,shutdown-delay-enable;

			qcom,qgauge@4800 {
				status = "okay";
				reg = <0x4800>;
				interrupts = <2 72 0 3 2 72 1 3
				              2 72 2 1 2 72 3 1
				              2 72 4 1>;
				interrupt-names = "qg-batt-missing", "qg-vbat-low", "qg-vbat-empty", "qg-fifo-done", "qg-good-ocv";
			};

			qcom,qg-sdam@b100 {
				status = "okay";
				reg = <0xb100>;
			};
		};

		pm7250b_clkdiv: clock-controller@5b00 {
			compatible = "qcom,spmi-clkdiv";
			reg = <0x5b00>;
			#clock-cells = <1>;
			qcom,num-clkdivs = <1>;
			clock-output-names = "pm7250b_div_clk1";
			clocks = <&rpmcc RPM_PXO_CLK>;
			clock-names = "xo";
			assigned-clocks = <&pm7250b_clkdiv 1>;
			assigned-clock-rates = <19200000>;
		};

		pm7250b_gpios: pinctrl@c000 {
			compatible = "qcom,pm7250b-gpio";
			reg = <0xc000>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;

			disp_lcd_bias_en {
				disp_lcd_bias_en_default: disp_lcd_bias_en_default {
					pins = "gpio5";
					function = "func1";
					input-disable;
					output-enable;
					bias-disable;
					power-source = <0>;
					qcom,drive-strength = <2>;
				};
			};

			pm7250b_smb_int_default: pm7250b_smb_int_default {
				pins = "gpio6";
				function = "gpio";
				input-enable;
				bias-pull-up;
				qcom,pull-up-strength = <0>;
				power-source = <0>;
			};
		};

		pm7250b_vadc: vadc@3100 {
			compatible = "qcom,spmi-adc5";
			reg = <0x3100>;
			reg-names = "adc5-usr-base";
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <2 49 0 1>;
			interrupt-names = "eoc-int-en-set";
			qcom,adc-vdd-reference = <1875>;
			#io-channel-cells = <1>;
			io-channel-ranges;

			ref_gnd@0 {
				reg = <0x0>;
				label = "ref_gnd";
				qcom,pre-scaling = <1 1>;
			};

			vref_1p25@1 {
				reg = <0x1>;
				label = "vref_1p25";
				qcom,pre-scaling = <1 1>;
			};

			die_temp@2 {
				reg = <0x6>;
				label = "die_temp";
				qcom,pre-scaling = <1 1>;
			};

			vph_pwr@83 {
				reg = <0x83>;
				label = "vph_pwr";
				qcom,pre-scaling = <1 3>;
			};

			vbat_sns@84 {
				reg = <0x84>;
				label = "vbat_sns";
				qcom,pre-scaling = <1 3>;
			};

			usb_in_i_uv@7 {
				reg = <0x7>;
				label = "usb_in_i_uv";
				qcom,pre-scaling = <1 1>;
			};

			usb_in_v_div_16@8 {
				reg = <0x8>;
				label = "usb_in_v_div_16";
				qcom,pre-scaling = <1 16>;
			};

			chg_temp@9 {
				reg = <0x9>;
				label = "chg_temp";
				qcom,pre-scaling = <1 1>;
			};

			bat_therm@4a {
				reg = <0x4a>;
				label = "bat_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
				qcom,pre-scaling = <1 1>;
			};

			bat_therm_30k@2a {
				reg = <0x2a>;
				label = "bat_therm_30k";
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
				qcom,pre-scaling = <1 1>;
			};

			bat_therm_400k@6a {
				reg = <0x6a>;
				label = "bat_therm_400k";
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
				qcom,pre-scaling = <1 1>;
			};

			bat_id@4b {
				reg = <0x4b>;
				label = "bat_id";
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
				qcom,pre-scaling = <1 1>;
			};

			smb1390_therm@e {
				reg = <0xe>;
				label = "smb1390_therm";
				qcom,hw-settle-time = <200>;
				qcom,pre-scaling = <1 1>;
			};

			chg_sbux@99 {
				reg = <0x99>;
				label = "chg_sbux";
				qcom,pre-scaling = <1 3>;
			};

			mid_chg_div6@1e {
				reg = <0x1e>;
				label = "chg_mid";
				qcom,pre-scaling = <1 6>;
			};

			charger_skin_therm@4d {
				reg = <0x4d>;
				label = "charger_skin_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
				qcom,pre-scaling = <1 1>;
			};

			conn_therm@4f {
				reg = <0x4f>;
				label = "conn_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
				qcom,pre-scaling = <1 1>;
			};
		};

		pm7250b_adc_tm: adc_tm@3500 {
			compatible = "qcom,spmi-adc-tm5";
			reg = <0x3500>;
			interrupts = <2 53 0 1>;
			interrupt-names = "pm-adc-tm5";
			#address-cells = <1>;
			#size-cells = <0>;
			#thermal-sensor-cells = <1>;
			status = "ok";

			charger_skin_therm@4d {
				reg = <0x0>;
				io-channels = <&pm7250b_vadc 77>;
				qcom,ratiometric;
				qcom,hw-settle-time-us = <200>;
			};

			conn_therm@4f {
				reg = <0x1>;
				io-channels = <&pm7250b_vadc 79>;
				qcom,ratiometric;
				qcom,hw-settle-time-us = <200>;
			};
		};

		pm7250b_bcl: bcl@1d00 {
			compatible = "qcom,bcl-v5";
			reg = <0x1d00>;
			interrupts = <2 29 0 0 2 29
			              1 0 2 29 2 0>;
			interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
			#thermal-sensor-cells = <1>;
		};

		bcl_soc: bcl-soc {
			compatible = "qcom,msm-bcl-soc";
			#thermal-sensor-cells = <0>;
		};
	};

	qcom,pm7250b@3 {
		compatible = "qcom,spmi-pmic";
		reg = <0x3 0x0>;
		#address-cells = <1>;
		#size-cells = <0>;

		pm7250b_vib: qcom,vibrator@5300 {
			compatible = "qcom,qpnp-vibrator-ldo";
			reg = <0x5300>;
			qcom,vib-ldo-volt-uv = <3000000>;
			qcom,disable-overdrive;
		};
	};
};

&thermal_zones {
	pm7250b_temp_alarm: pm7250b-tz {
		polling-delay-passive = <100>;
		polling-delay = <0>;
		thermal-sensors = <&pm7250b_tz>;

		trips {
			pm7250b_trip0: trip0 {
				temperature = <95000>;
				hysteresis = <0>;
				type = "passive";
			};

			pm7250b_trip1: trip1 {
				temperature = <115000>;
				hysteresis = <0>;
				type = "passive";
			};

			trip2 {
				temperature = <145000>;
				hysteresis = <0>;
				type = "passive";
			};
		};
	};

	pm7250b-ibat-lvl0 {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&pm7250b_bcl 0>;

		trips {
			ibat_lvl0: ibat-lvl0 {
				temperature = <5500>;
				hysteresis = <200>;
				type = "passive";
			};
		};
	};

	pm7250b-ibat-lvl1 {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&pm7250b_bcl 1>;

		trips {
			ibat_lvl1: ibat-lvl1 {
				temperature = <6000>;
				hysteresis = <200>;
				type = "passive";
			};
		};
	};

	pm7250b-bcl-lvl0 {
		polling-delay-passive = <100>;
		polling-delay = <0>;
		thermal-sensors = <&pm7250b_bcl 5>;

		trips {
			b_bcl_lvl0: b-bcl-lvl0 {
				temperature = <1>;
				hysteresis = <1>;
				type = "passive";
			};
		};
	};

	pm7250b-bcl-lvl1 {
		polling-delay-passive = <100>;
		polling-delay = <0>;
		thermal-sensors = <&pm7250b_bcl 6>;

		trips {
			b_bcl_lvl1: b-bcl-lvl1 {
				temperature = <1>;
				hysteresis = <1>;
				type = "passive";
			};
		};
	};

	pm7250b-bcl-lvl2 {
		polling-delay-passive = <100>;
		polling-delay = <0>;
		thermal-sensors = <&pm7250b_bcl 7>;

		trips {
			b_bcl_lvl2: b-bcl-lvl2 {
				temperature = <1>;
				hysteresis = <1>;
				type = "passive";
			};
		};
	};

	socd {
		polling-delay-passive = <100>;
		polling-delay = <0>;

		trips {
			thermal-engine-trip {
				temperature = <100>;
				hysteresis = <0>;
				type = "passive";
			};

			thermal-hal-trip {
				temperature = <100>;
				hysteresis = <0>;
				type = "passive";
			};

			soc_trip: soc-trip {
				temperature = <90>;
				hysteresis = <0>;
				type = "passive";
			};
		};
	};
};

&thermal_zones {
	charger-therm-usr {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "user_space";
		thermal-sensors = <&pm7250b_adc_tm 0>;
		wake-capable-sensor;

		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	conn-therm-usr {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "user_space";
		thermal-sensors = <&pm7250b_adc_tm 1>;
		wake-capable-sensor;

		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};
};

&thermal_zones {
	pm7250b-tz {
		cooling-maps {
			trip0_bat {
				trip = <&pm7250b_trip0>;
				cooling-device = <&pm7250b_charger 9 9>;
			};

			trip1_bat {
				trip = <&pm7250b_trip1>;
				cooling-device = <&pm7250b_charger 10 10>;
			};
		};
	};

	socd {
		cooling-maps {
			soc_cpu4 {
				trip = <&soc_trip>;
				cooling-device = <&cpu4_pause 1 1>;
			};

			soc_cpu5 {
				trip = <&soc_trip>;
				cooling-device = <&cpu5_pause 1 1>;
			};

			soc_cpu6 {
				trip = <&soc_trip>;
				cooling-device = <&cpu6_pause 1 1>;
			};

			soc_cpu7 {
				trip = <&soc_trip>;
				cooling-device = <&cpu7_pause 1 1>;
			};
		};
	};

	pm7250b-bcl-lvl0 {
		cooling-maps {
			lbat0_cpufreq4 {
				trip = <&b_bcl_lvl0>;
				cooling-device = <&CPU4 2 2>;
			};

			lbat0_cpu6 {
				trip = <&b_bcl_lvl0>;
				cooling-device = <&cpu6_pause 1 1>;
			};

			lbat0_cpu7 {
				trip = <&b_bcl_lvl0>;
				cooling-device = <&cpu7_pause 1 1>;
			};

			lbat0_gpu {
				trip = <&b_bcl_lvl0>;
				cooling-device = <&msm_gpu 2 2>;
			};

			lbat0_cdsp {
				trip = <&b_bcl_lvl0>;
				cooling-device = <&cdsp_sw 2 2>;
			};
		};
	};

	pm7250b-bcl-lvl1 {
		cooling-maps {
			lbat1_cpu4 {
				trip = <&b_bcl_lvl1>;
				cooling-device = <&cpu4_pause 1 1>;
			};

			lbat1_cpu5 {
				trip = <&b_bcl_lvl1>;
				cooling-device = <&cpu5_pause 1 1>;
			};

			lbat1_gpu {
				trip = <&b_bcl_lvl1>;
				cooling-device = <&msm_gpu 4 4>;
			};

			lbat1_cdsp {
				trip = <&b_bcl_lvl1>;
				cooling-device = <&cdsp_sw 4 4>;
			};
		};
	};

	pm7250b-bcl-lvl2 {
		cooling-maps {
			lbat2_gpu {
				trip = <&b_bcl_lvl2>;
				cooling-device = <&msm_gpu 4 0xffffffff>;
			};

			lbat2_cdsp {
				trip = <&b_bcl_lvl2>;
				cooling-device = <&cdsp_sw 4 4>;
			};
		};
	};
};

&soc {
	onewire_gpio: onewire_gpio {
		compatible = "xiaomi,onewire_gpio";
		label = "xm_onewire";
		xiaomi,version = <1>;
		onewire-gpio = <&tlmm 66 0>;
		xiaomi,gpio_number = <66>;
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&onewire_gpio_active>;
		pinctrl-1 = <&onewire_gpio_sleep>;
		status = "ok";
	};

	maxim_ds28e30: maxim_ds28e30 {
		#io-channel-cells = <1>;
		compatible = "maxim,ds28e30";
		label = "max_ds28e30";
		maxim,version = <1>;
		status = "ok";
	};

	acl_slg: acl_slg {
		compatible = "acl,slg";
		status = "okay";
		def-supply = <&maxim_ds28e30>;
	};

	st_stick: st_stick {
		compatible = "st,stick";
		status = "okay";
		def-supply = <&maxim_ds28e30 &acl_slg>;
	};

	auth_battery: auth_battery {
		compatible = "lc,auth-battery";
		status = "okay";
		#io-channel-cells = <1>;
		def-supply = <&maxim_ds28e30 &acl_slg &st_stick>;
	};
};

&tlmm {
	onewire_gpio_active: onewire_gpio_active {
		mux {
			pins = "gpio66";
			function = "gpio";
		};

		config {
			pins = "gpio66";
			drive-strength = <16>;
			bias-pull-up;
		};
	};

	onewire_gpio_sleep: onewire_gpio_sleep {
		mux {
			pins = "gpio66";
			function = "gpio";
		};

		config {
			pins = "gpio66";
			drive-strength = <16>;
			bias-pull-up;
		};
	};
};

&soc {
	xm_smart_chg: xm_smart_chg {
		compatible = "xiaomi,xm_smart_chg";
		status = "ok";
		label = "smart_charging";
		xiaomi,pd-thermal-mitigation = <5950000 5400000 5000000 4500000 4000000 3700000 3500000 3000000
		                                2800000 2500000 2000000 1500000 1000000 800000 500000 350000
		                                800000 800000>;
		xiaomi,pd-thermal-mitigation-fast = <6000000 5950000 5950000 5400000 5000000 4500000 4000000 3700000
		                                     2800000 2500000 2000000 1500000 1000000 800000 500000 350000
		                                     800000 800000>;
		io-channels = <&pm7250b_qg PSY_IIO_CAPACITY &pm7250b_charger PSY_IIO_PD_ACTIVE
		               &pm7250b_qg PSY_IIO_CAPACITY_RAW>;
		io-channel-names = "capacity", "pd_active", "capacity_raw";
	};
};

&soc {
	mtp_batterydata: qcom,battery-data {
		qcom,batt-id-range-pct = <15>;

		qcom,qbg-battery-profile-guanyu-5000mAh {
			qcom,max-voltage-uv = <4500000>;
			qcom,fg-cc-cv-threshold-uv = <4500000>;
			qcom,fastchg-current-ma = <6000>;
			qcom,batt-id-kohm = <100>;
			qcom,battery-beta = <3380>;
			qcom,battery-therm-kohm = <10>;
			qcom,battery-type = "qbg-battery-profile-guanyu-5000mAh-new";
			qcom,qg-batt-profile-ver = <100>;
			qcom,jeita-fcc-ranges = <0xffffff9c 0 400000 0 50 850000 50 100
			                         2300000 100 150 3700000 150 350 6000000 350
			                         480 6000000 480 560 2300000 560 1500 0>;
			qcom,jeita-fv-ranges = <0xffffff9c 0 4460000 0 50 4480000 50 100
			                        4480000 100 150 4480000 150 350 4450000 350
			                        480 4450000 480 560 4100000 560 1500 4100000>;
			qcom,step-chg-ranges = <3600000 4250000 6000000 4250001 4480000 5400000 4480001 4500000
			                        3920000>;
			qcom,vbat-avg-based-step-chg;
			qcom,taper-fcc;
			qcom,jeita-soft-thresholds = <9556 3725>;
			qcom,jeita-hard-thresholds = <17365 2971>;
			qcom,jeita-soft-hys-thresholds = <8799 4060>;
			qcom,jeita-soft-fcc-ua = <5400000 2500000>;
			qcom,jeita-soft-fv-uv = <4480000 4100000>;

			qcom,fcc1-temp-lut {
				qcom,lut-col-legend = <0 10 25 40 50>;
				qcom,lut-data = [00 00 13 cd 00 00 14 01 00 00 14 6c 00 00 14 91 00 00 14 9a];
			};

			qcom,fcc2-temp-lut {
				qcom,lut-col-legend = <0xfffffff6 0 10 25 40 50>;
				qcom,lut-data = [00 00 13 f2 00 00 14 1c 00 00 14 1c 00 00 14 80 00 00 14 7c 00 00 14 73];
			};

			qcom,pc-temp-v1-lut {
				qcom,lut-col-legend = <0 10 25 40 50>;
				qcom,lut-row-legend = <10000 9800 9600 9400 9200 9000 8800 8600
				                       8400 8200 8000 7800 7600 7400 7200 7000
				                       6800 6600 6400 6200 6000 5800 5600 5400
				                       5200 5000 4800 4600 4400 4200 4000 3800
				                       3600 3400 3200 3000 2800 2600 2400 2200
