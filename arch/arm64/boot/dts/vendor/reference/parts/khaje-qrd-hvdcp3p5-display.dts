		qcom,sde-pp-size = <212>;
		qcom,sde-dsc-off = <0x81000>;
		qcom,sde-dsc-size = <320>;
		qcom,sde-dither-off = <12512>;
		qcom,sde-dither-version = <0x10000>;
		qcom,sde-dither-size = <32>;
		qcom,sde-sspp-type = "vig", "dma";
