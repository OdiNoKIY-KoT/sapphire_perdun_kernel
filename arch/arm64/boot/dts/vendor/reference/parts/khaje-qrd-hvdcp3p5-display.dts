		qcom,sde-safe-lut-linear = <0 65520>;
		qcom,sde-safe-lut-macrotile = <0 65280>;
		qcom,sde-safe-lut-macrotile-qseed = <0 65280>;
		qcom,sde-safe-lut-nrt = <0 65535>;
		qcom,sde-qos-lut-linear = <0 1122850 573790071>;
		qcom,sde-qos-lut-macrotile = <0 1122867 1146447479>;
		qcom,sde-qos-lut-macrotile-qseed = <0 1122867 1719105399>;
		qcom,sde-qos-lut-nrt = <0 0 0>;
		qcom,sde-cdp-setting = <1 1 1 0>;
		qcom,sde-qos-cpu-mask = <0x3>;
		qcom,sde-qos-cpu-dma-latency = <300>;
		qcom,sde-qos-cpu-irq-latency = <300>;
		qcom,sde-secure-sid-mask = <0x421>;
		qcom,sde-num-mnoc-ports = <1>;
		qcom,sde-axi-bus-width = <16>;
		qcom,sde-reg-bus,vectors-KBps = <0 0 0 76800 0 150000 0 300000>;
		clocks = <&gcc GCC_DISP_HF_AXI_CLK &gcc GCC_DISP_THROTTLE_CORE_CLK
		          &gcc GCC_DISP_GPLL0_DIV_CLK_SRC &dispcc DISP_CC_MDSS_AHB_CLK
		          &dispcc DISP_CC_MDSS_MDP_CLK &dispcc DISP_CC_MDSS_VSYNC_CLK
		          &dispcc DISP_CC_MDSS_MDP_LUT_CLK>;
		clock-names = "gcc_bus", "throttle_clk", "div_clk", "iface_clk", "core_clk", "vsync_clk", "lut_clk";
		clock-rate = <0 0 0 0 383000000 19200000 383000000>;
		clock-max-rate = <0 0 0 0 560000000 19200000 560000000>;
		sde-vdd-supply = <&mdss_core_gdsc>;
		interconnects = <&mmrt_virt MASTER_MDP_PORT0 &bimc SLAVE_EBI_CH0
		                 &bimc MASTER_AMPSS_M0 &config_noc SLAVE_DISPLAY_CFG>;
		interconnect-names = "qcom,sde-data-bus0", "qcom,sde-reg-bus";
		qcom,sde-ib-bw-vote = <2400000 0 1600000>;
		connectors = <&sde_dsi &smmu_sde_sec &smmu_sde_unsec>;

		qcom,sde-sspp-vig-blocks {
			qcom,sde-vig-inverse-pma;
			qcom,sde-vig-qseed-size = <160>;
			qcom,sde-vig-qseed-off = <2560>;
			qcom,sde-vig-csc-off = <6656>;
		};

		qcom,sde-dspp-blocks {
			qcom,sde-dspp-dither = <2092 65543>;
			qcom,sde-dspp-gc = <6080 65544>;
			qcom,sde-dspp-pcc = <5888 0x40000>;
			qcom,sde-dspp-vlut = <2560 65544>;
			qcom,sde-dspp-sixzone = <2304 65543>;
			qcom,sde-dspp-hist = <2048 65543>;
			qcom,sde-dspp-memcolor = <2176 65543>;
			qcom,sde-dspp-hsic = <2048 65543>;
			qcom,sde-dspp-igc = <0 196609>;
		};

		qcom,platform-supply-entries {
			#size-cells = <0>;
			#address-cells = <1>;

			qcom,platform-supply-entry@0 {
				qcom,supply-disable-load = <0>;
				qcom,supply-enable-load = <0>;
				qcom,supply-max-voltage = <0>;
				qcom,supply-min-voltage = <0>;
				qcom,supply-name = "sde-vdd";
				reg = <0x0>;
			};
		};

		qcom,sde-limits {
			qcom,sde-linewidth-limits {
				qcom,sde-limit-values = <1 4096 5 2560 2 2160>;
				qcom,sde-limit-ids = <1 2 4>;
				qcom,sde-limit-cases = "vig", "dma", "scale";
				qcom,sde-limit-name = "sspp_linewidth_usecases";
			};

			qcom,sde-bw-limits {
				qcom,sde-limit-values = <1 3200000 9 3200000 2 3200000 10 3200000
				                         4 4300000 12 3200000>;
				qcom,sde-limit-ids = <1 2 4 8>;
				qcom,sde-limit-cases = "per_vig_pipe", "per_dma_pipe", "total_max_bw", "camera_concurrency";
				qcom,sde-limit-name = "sde_bwlimit_usecases";
			};
		};

		dsi_td4330_truly_v2_cmd: qcom,mdss_dsi_td4330_truly_v2_cmd {
