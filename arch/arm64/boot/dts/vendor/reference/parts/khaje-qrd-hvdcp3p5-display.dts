/* display techpack overlay part, first used by stock dtbo entry 10 (Qualcomm Technologies, Inc. Khaje QRD HVDCP3P5);
 * reconstructed from the stock dtbo.img. */

/dts-v1/;
/plugin/;

#include <dt-bindings/clock/qcom,dispcc-khaje.h>
#include <dt-bindings/clock/qcom,gcc-khaje.h>
#include <dt-bindings/interconnect/qcom,bengal.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>

&soc {
	mdss_mdp: qcom,mdss_mdp {
		compatible = "qcom,sde-kms";
		reg = <0x5e00000 0x8f030 0x5eb0000 0x2008 0x5e8f000 0x30>;
		reg-names = "mdp_phys", "vbif_phys", "sid_phys";
		interrupts = <GIC_SPI 186 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-controller;
		#interrupt-cells = <1>;
		#power-domain-cells = <0>;
		#list-cells = <1>;
		#cooling-cells = <2>;
		qcom,sde-off = <4096>;
		qcom,sde-len = <1172>;
		qcom,sde-ctl-off = <8192>;
		qcom,sde-ctl-size = <476>;
		qcom,sde-ctl-display-pref = "primary";
		qcom,sde-mixer-off = <0x45000>;
		qcom,sde-mixer-size = <800>;
		qcom,sde-mixer-display-pref = "primary";
		qcom,sde-dspp-top-off = <4864>;
		qcom,sde-dspp-top-size = <128>;
