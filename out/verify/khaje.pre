    bias-pull-up;
    drive-strength = <10>;
   };

   sd-cd {
    pins = "gpio88";
    bias-pull-up;
    drive-strength = <2>;
   };
  };

  sdc2_off: sdc2_off {
   clk {
    pins = "sdc2_clk";
    bias-disable;
    drive-strength = <2>;
