     remote-endpoint =
     <&tpdm_dcc_out_tpda8>;
    };
   };

   port@10 {
    reg = <10>;
    tpda10_in_tpdm_prng: endpoint {
     remote-endpoint =
     <&tpdm_prng_out_tpda10>;
    };
   };

   port@12 {
