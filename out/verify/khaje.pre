  arm,primecell-periphid = <0x000bb922>;
  reg = <0x8019000 0x1000>;
  reg-names = "cti-base";

  coresight-name = "coresight-cti9";

  clocks = <&rpmcc 8>;
  clock-names = "apb_pclk";
 };

};
# 601 "/home/angel/sapphire/ws/devicetree/qcom/khaje.dtsi" 2

&soc {
 #address-cells = <1>;
 #size-cells = <1>;
 ranges = <0 0 0 0xffffffff>;
 compatible = "simple-bus";

 slimbam: bamdma@0xa584000 {
  compatible = "qcom,bam-v1.7.0";
  qcom,controlled-remotely;
  reg = <0xa584000 0x20000>, <0xa66f000 0x1000>;
  reg-names = "bam", "bam_remote_mem";
  num-channels = <31>;
  interrupts = <0 284 4>;
  #dma-cells = <1>;
  qcom,ee = <1>;
  qcom,num-ees = <2>;
 };

 slim_msm: slim@a5c0000 {
  compatible = "qcom,slim-ngd-v1.5.0";
  reg = <0xa5c0000 0x2C000>, <0xa66e000 0x1000>;
  reg-names = "ctrl", "slimbus_remote_mem";
  interrupts = <0 283 4>;
  qcom,apps-ch-pipes = <0x0>;
  qcom,ea-pc = <0x3b0>;
  dmas = <&slimbam 3>, <&slimbam 4>;
  dma-names = "rx", "tx";
  #address-cells = <1>;
  #size-cells = <0>;
  status = "disabled";
 };

 intc: interrupt-controller@f200000 {
  compatible = "arm,gic-v3";
  #interrupt-cells = <3>;
  interrupt-controller;
  interrupt-parent = <&intc>;
  #redistributor-regions = <1>;
  redistributor-stride = <0x0 0x20000>;
  reg = <0xf200000 0x10000>,
        <0xf300000 0x100000>;
  interrupts = <1 9 4>;
 };

 clk_virt: interconnect {
  compatible = "qcom,bengal-clk_virt";
  qcom,keepalive;
  #interconnect-cells = <1>;
  clock-names = "bus", "bus_a";
  clocks = <&rpmcc 106>,
  <&rpmcc 107>;
 };

 mmnrt_virt: interconnect@0 {
  compatible = "qcom,bengal-mmnrt_virt";
  #interconnect-cells = <1>;
  qcom,util-factor = <142>;
  qcom,keepalive;
  clock-names = "bus", "bus_a";
  clocks = <&rpmcc 110>,
    <&rpmcc 111>;
  };

 mmrt_virt: interconnect@1 {
  compatible = "qcom,bengal-mmrt_virt";
  #interconnect-cells = <1>;
  qcom,util-factor = <139>;
  qcom,keepalive;
  clock-names = "bus", "bus_a";
  clocks = <&rpmcc 108>,
    <&rpmcc 109>;
  };

 system_noc: interconnect@1880000 {
  compatible = "qcom,bengal-system_noc";
  reg = <0x01880000 0x5f080>;
  #interconnect-cells = <1>;
  qcom,keepalive;
  clock-names = "bus", "bus_a";
  clocks = <&rpmcc 4>,
    <&rpmcc 5>,
    <&gcc 56>,
    <&gcc 116>;
 };

 config_noc: interconnect@1900000 {
  compatible = "qcom,bengal-config_noc";
  reg = <0x01900000 0x6200>;
  #interconnect-cells = <1>;
  qcom,keepalive;
  clock-names = "bus", "bus_a";
  clocks = <&rpmcc 28>,
    <&rpmcc 29>;
  };

 bimc: interconnect@4480000 {
  compatible = "qcom,bengal-bimc";
  reg = <0x04480000 0x80000>;
  #interconnect-cells = <1>;
  qcom,util-factor = <153>;
  qcom,keepalive;
  clock-names = "bus", "bus_a";
  clocks = <&rpmcc 6>,
    <&rpmcc 7>;
  };

