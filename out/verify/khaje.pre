# 1 "/home/angel/sapphire/ws/devicetree/qcom/bengal-qupv3.dtsi" 1
&soc {


 gpi_dma0: qcom,gpi-dma@4a00000 {
  compatible = "qcom,gpi-dma";
  #dma-cells = <5>;
  reg = <0x4a00000 0x60000>;
  reg-names = "gpi-top";
  interrupts = <0 335 4>,
   <0 336 4>,
   <0 337 4>,
   <0 338 4>,
   <0 339 4>,
   <0 340 4>,
   <0 341 4>,
   <0 342 4>,
   <0 343 4>,
   <0 344 4>;
  qcom,max-num-gpii = <10>;
  qcom,gpii-mask = <0xf>;
  qcom,ev-factor = <2>;
  iommus = <&apps_smmu 0xf6 0x0>;
  qcom,gpi-ee-offset = <0x10000>;
  qcom,iommu-dma-addr-pool = <0x100000 0x100000>;
  status = "ok";
 };


 qupv3_0: qcom,qupv3_0_geni_se@4ac0000 {
  compatible = "qcom,geni-se-qup";
  reg = <0x4ac0000 0x2000>;
  #address-cells = <1>;
  #size-cells = <1>;
  clock-names = "m-ahb", "s-ahb";
  clocks = <&gcc 104>,
   <&gcc 105>;
  iommus = <&apps_smmu 0xE3 0x0>;
  qcom,iommu-dma-addr-pool = <0x40000000 0x10000000>;
  qcom,iommu-geometry = <0x40000000 0x10000000>;
  qcom,iommu-dma = "fastmap";
  ranges;
  status = "ok";


  qupv3_se4_2uart: qcom,qup_uart@4a90000 {
   compatible = "qcom,geni-debug-uart";
   reg = <0x4a90000 0x4000>;
   reg-names = "se_phys";
   interrupts = <0 331 4>;
   clock-names = "se";
   clocks = <&gcc 100>;
   interconnect-names = "qup-core", "qup-config", "qup-memory";
   interconnects = <&clk_virt 6 &clk_virt 514>,
   <&bimc 0 &config_noc 550>,
   <&system_noc 23 &bimc 512>;
   pinctrl-names = "default", "sleep";
   pinctrl-0 = <&qupv3_se4_2uart_active>;
   pinctrl-1 = <&qupv3_se4_2uart_sleep>;
   qcom,wrapper-core = <&qupv3_0>;
   status = "disabled";
  };


  qupv3_se3_4uart: qcom,qup_uart@4a8c000 {
   compatible = "qcom,msm-geni-serial-hs";
   reg = <0x4a8c000 0x4000>;
   reg-names = "se_phys";
   clock-names = "se-clk";
   clocks = <&gcc 98>;
   interconnect-names = "qup-core", "qup-config", "qup-memory";
   interconnects = <&clk_virt 6 &clk_virt 514>,
   <&bimc 0 &config_noc 550>,
   <&system_noc 23 &bimc 512>;
   dmas = <&gpi_dma0 0 1 2 64 0>,
   <&gpi_dma0 1 1 2 64 0>;
   dma-names = "tx", "rx";
   pinctrl-names = "default", "active", "sleep", "shutdown";
   interrupts-extended = <&intc 0 330 4>,
     <&tlmm 11 4>;
   pinctrl-0 = <&qupv3_se3_default_cts>, <&qupv3_se3_default_rts>,
    <&qupv3_se3_default_tx>, <&qupv3_se3_default_rx>;
   pinctrl-1 = <&qupv3_se3_cts>, <&qupv3_se3_rts>,
    <&qupv3_se3_tx>, <&qupv3_se3_rx>;
   pinctrl-2 = <&qupv3_se3_cts>, <&qupv3_se3_rts>,
    <&qupv3_se3_tx>, <&qupv3_se3_default_rx>;
   pinctrl-3 = <&qupv3_se3_default_cts>, <&qupv3_se3_default_rts>,
    <&qupv3_se3_default_tx>, <&qupv3_se3_default_rx>;
   qcom,wrapper-core = <&qupv3_0>;
   qcom,wakeup-byte = <0xFD>;
   status = "disabled";
  };


  qupv3_se0_i2c: i2c@4a80000 {
   compatible = "qcom,i2c-geni";
   reg = <0x4a80000 0x4000>;
   #address-cells = <1>;
   #size-cells = <0>;
   interrupts = <0 327 4>;
   clock-names = "se-clk";
   clocks = <&gcc 92>;
   interconnect-names = "qup-core", "qup-config", "qup-memory";
   interconnects = <&clk_virt 6 &clk_virt 514>,
   <&bimc 0 &config_noc 550>,
   <&system_noc 23 &bimc 512>;
   dmas = <&gpi_dma0 0 0 3 64 0>,
    <&gpi_dma0 1 0 3 64 0>;
   dma-names = "tx", "rx";
   pinctrl-names = "default", "sleep";
   pinctrl-0 = <&qupv3_se0_i2c_active>;
   pinctrl-1 = <&qupv3_se0_i2c_sleep>;
   qcom,wrapper-core = <&qupv3_0>;
   status = "disabled";
  };


  qupv3_se1_i2c: i2c@4a84000 {
   compatible = "qcom,i2c-geni";
   reg = <0x4a84000 0x4000>;
   #address-cells = <1>;
   #size-cells = <0>;
   interrupts = <0 328 4>;
   clock-names = "se-clk";
   clocks = <&gcc 94>;
   interconnect-names = "qup-core", "qup-config", "qup-memory";
   interconnects = <&clk_virt 6 &clk_virt 514>,
   <&bimc 0 &config_noc 550>,
   <&system_noc 23 &bimc 512>;
   dmas = <&gpi_dma0 0 1 3 64 0>,
    <&gpi_dma0 1 1 3 64 0>;
   dma-names = "tx", "rx";
   pinctrl-names = "default", "sleep";
   pinctrl-0 = <&qupv3_se1_i2c_active>;
   pinctrl-1 = <&qupv3_se1_i2c_sleep>;
   qcom,wrapper-core = <&qupv3_0>;
   status = "disabled";
